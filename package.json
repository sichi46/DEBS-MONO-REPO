{
  "private": true,
  "scripts": {
    "ggg": "hgjhgh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:run",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:format": "syncpack format",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "syncpack": "^14.2.1",
    "turbo": "^2.7.5"
  },
  "packageManager": "pnpm@8.15.6",
  "name": "with-vite"
}
