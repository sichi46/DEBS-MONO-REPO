{
  "version": 2,
  "buildCommand": "prisma generate",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lenco-reconcile",
      "schedule": "*/15 * * * *"
    }
  ]
}
