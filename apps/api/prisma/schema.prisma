generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User & Authentication
// =============================================================================

enum UserRole {
  ADMIN
  AGENT
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  phone         String?
  address       String?
  avatarUrl     String?
  
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  
  emailVerified Boolean    @default(false)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  policies      Policy[]
  claims        Claim[]
  payments      Payment[]
  lencoCollections LencoCollection[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@map("password_resets")
}

// =============================================================================
// Insurance Domain Models
// =============================================================================

enum PolicyStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
}

model PolicyType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  minPremium  Decimal  @db.Decimal(12, 2)
  
  policies    Policy[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("policy_types")
}

model Policy {
  id              String       @id @default(cuid())
  policyNumber    String       @unique
  
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  
  policyTypeId    String
  policyType      PolicyType   @relation(fields: [policyTypeId], references: [id])
  
  status          PolicyStatus @default(PENDING)
  coverageAmount  Decimal      @db.Decimal(12, 2)
  premiumAmount   Decimal      @db.Decimal(12, 2)
  
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  // Relations
  beneficiaries   Beneficiary[]
  claims          Claim[]
  payments        Payment[]
  lencoCollections LencoCollection[]

  @@map("policies")
}

model Beneficiary {
  id           String  @id @default(cuid())
  policyId     String
  policy       Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  name         String
  relationship String
  percentage   Int     // 0-100
  phone        String?
  email        String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("beneficiaries")
}

model Claim {
  id            String      @id @default(cuid())
  claimNumber   String      @unique
  
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  
  policyId      String
  policy        Policy      @relation(fields: [policyId], references: [id])
  
  claimType     String
  status        ClaimStatus @default(PENDING)
  amount        Decimal     @db.Decimal(12, 2)
  description   String?
  
  submittedAt   DateTime    @default(now())
  processedAt   DateTime?
  processedBy   String?     // Admin user ID who processed

  payoutStatus       PayoutStatus?
  payoutAmount       Decimal?      @db.Decimal(12, 2)
  payoutCompletedAt  DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Lenco payout relation
  lencoTransfers LencoTransfer[]

  @@map("claims")
}

model Payment {
  id            String        @id @default(cuid())
  
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  
  policyId      String
  policy        Policy        @relation(fields: [policyId], references: [id])
  
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  
  transactionId String?
  paidAt        DateTime?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lencoCollection LencoCollection?

  @@map("payments")
}

// =============================================================================
// Lenco Payment Gateway
// =============================================================================

enum LencoTransferStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

model LencoTransferRecipient {
  id            String   @id @default(cuid())
  lencoId       String   @unique
  accountName   String
  accountNumber String
  bankId        String
  bankName      String
  currency      String   @default("ZMW")
  country       String   @default("ZM")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transfers     LencoTransfer[]

  @@map("lenco_transfer_recipients")
}

model LencoTransfer {
  id            String              @id @default(cuid())
  lencoId       String?             @unique
  reference     String              @unique

  recipientId   String
  recipient     LencoTransferRecipient @relation(fields: [recipientId], references: [id])

  accountId     String
  amount        Decimal             @db.Decimal(12, 2)
  narration     String
  status        LencoTransferStatus @default(PENDING)

  claimId       String?
  claim         Claim?              @relation(fields: [claimId], references: [id])

  lencoResponse Json?
  failureReason String?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("lenco_transfers")
}

model LencoWebhookEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("lenco_webhook_events")
}

enum LencoCollectionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  PAY_OFFLINE
}

model LencoCollection {
  id            String                @id @default(cuid())
  lencoId       String?               @unique
  reference     String                @unique

  userId        String
  user          User                  @relation(fields: [userId], references: [id])

  policyId      String
  policy        Policy                @relation(fields: [policyId], references: [id])

  amount        Decimal               @db.Decimal(12, 2)
  currency      String                @default("ZMW")
  provider      String
  phoneNumber   String
  status        LencoCollectionStatus @default(PENDING)

  paymentId     String?               @unique
  payment       Payment?              @relation(fields: [paymentId], references: [id])

  lencoResponse Json?
  failureReason String?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("lenco_collections")
}
